<script>
  const els = [...document.querySelectorAll<HTMLElement>('.r')];
  // Anything already on screen shows at once; the observer handles the rest on scroll.
  for (const el of els) if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('on');
  const io = new IntersectionObserver(
    (es) =>
      es.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('on');
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.1 },
  );
  els.filter((el) => !el.classList.contains('on')).forEach((el) => io.observe(el));
</script>
