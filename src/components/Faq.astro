---
import Screen from './Screen.astro';
import type { Dict } from '../i18n';
const { dict } = Astro.props as { dict: Dict };
---
<Screen id="faq" tone="lilac" label={dict.faq.label} number="08">
  <div class="faq r">
    {dict.faq.items.map((f, i) => (
      <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </div>
  <Fragment slot="footer"><span>{dict.faq.footer}</span><span>↓</span></Fragment>
</Screen>
