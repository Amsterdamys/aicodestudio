---
interface Props {
  id?: string;
  tone?: 'paper' | 'violet' | 'lilac' | 'ink';
  label: string;
  number: string;
}
const { id, tone = 'paper', label, number } = Astro.props;
const cls = ['s', tone === 'paper' ? '' : tone].filter(Boolean).join(' ');
---
<section class={cls} id={id} data-screen-label={`${number} ${label}`}>
  <div class="hd"><span>{label}</span><span>{number}</span></div>
  <div class="mid"><slot /></div>
  <div class="ft"><slot name="footer" /></div>
</section>
