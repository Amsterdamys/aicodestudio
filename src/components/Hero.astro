---
import Screen from './Screen.astro';
import type { Dict } from '../i18n';
const { dict } = Astro.props as { dict: Dict };
---
<Screen id="top" label={dict.hero.label} number="01" extraClass="hero">
  <p class="k r">AI</p>
  <div class="r">
    <h1>{dict.hero.headline}<b>{dict.hero.headlineBold}</b>{dict.hero.headlineTail}</h1>
    <a class="btn" href="#contact">{dict.hero.cta}</a>
  </div>
</Screen>
