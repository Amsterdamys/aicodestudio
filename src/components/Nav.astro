---
import { locales, type Dict, type Locale } from '../i18n';
import { site } from '../site.config';
interface Props { locale: Locale; dict: Dict }
const { locale, dict } = Astro.props;
const links: [string, string][] = [
  ['#services', dict.nav.services],
  ['#stack', dict.nav.stack],
  ['#process', dict.nav.process],
  ['#why', dict.nav.why],
  ['#faq', dict.nav.faq],
  ['#contact', dict.nav.contact],
];
---
<nav>
  <div class="in">
    <a href="#top"><b>{site.name}</b></a>
    <div class="links">{links.map(([href, label]) => <a href={href}>{label}</a>)}</div>
    <div class="lang">
      <form action="/" method="get" data-lang-form>
        <select name="lang" aria-label={dict.lang.switch}>
          {locales.map((l) => <option value={l} selected={l === locale}>{l.toUpperCase()}</option>)}
        </select>
        <noscript><button type="submit">→</button></noscript>
      </form>
    </div>
  </div>
</nav>
<script>
  document.querySelector<HTMLSelectElement>('[data-lang-form] select')?.addEventListener('change', (e) => {
    const lang = (e.target as HTMLSelectElement).value;
    window.location.href = `/?lang=${encodeURIComponent(lang)}`;
  });
</script>
